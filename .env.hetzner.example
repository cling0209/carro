# Hetzner VPS — copiar en el servidor como /opt/carro/.env.prod
# POSTGRES_USER y DB_USERNAME deben coincidir; DB_PASSWORD = POSTGRES_PASSWORD

ADMIN_OTP_ENABLED=false
APP_DEBUG=false
APP_ENV=production
APP_KEY=
APP_NAME=Rómulo
APP_TIMEZONE=America/Santiago
APP_URL=https://tienda.romulo.cl
ASSET_URL=https://tienda.romulo.cl
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tienda
DB_USERNAME=carro
DB_PASSWORD=
DB_QUEUE_RETRY_AFTER=1200

POSTGRES_DB=tienda
POSTGRES_USER=carro
POSTGRES_PASSWORD=

LOG_CHANNEL=stderr
LOG_LEVEL=error

MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=tienda@romulo.cl
MAIL_FROM_NAME=Rómulo

PRODUCT_STORAGE_DISK=r2
PRODUCT_IMAGE_BASE_URL=
PRODUCT_IMAGE_FILENAME_PATTERN={codigo}.jpg
PRODUCT_IMPORT_AUTO_CREATE_CATEGORIES=true
PRODUCT_IMPORT_BACKGROUND=true

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_IMAGE_PREFIX=productos
R2_REGION=auto

TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_ENV=integration
TRANSBANK_RETURN_URL=https://tienda.romulo.cl/checkout/webpay/return

RUN_MIGRATIONS=true
RUN_SEED=false
RUN_QUEUE_WORKER=true
